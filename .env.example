# Copy to .env if you want fixed keys. Everything here is optional: without it the scripts use
# throwaway keys, which is fine on Studionet because it is gasless.
#
# TRIANGULATE_PRIVATE_KEY=0x...64 hex characters...   deployer and signer 0
# TRIANGULATE_PRIVATE_KEYS=0x...,0x...                 extra signers (the e2e run needs three in total)
# TRIANGULATE_RPC=https://studio.genlayer.com/api
# TRIANGULATE_ADDRESS=0x...                            use an existing deployment
